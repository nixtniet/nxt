#!/usr/bin/env python3


import inspect
import os
import sys


sys.path.insert(0, os.getcwd())


import nixt.defines


from nixt.defines import *


local = locals()


for name in dir(nixt.defines):
    cls = local.get(name)
    print("def %s:\n\n\t" % name)
    for x in [str(x) for x in inspect.get_annotations(cls)]:
        print(x)
    for name, func in inspect.getmembers(cls, inspect.ismethod):
        ann = dict(inspect.get_annotations(func))
        ret = ann.get('return', None)
        if ret:
            del ann["return"]
        val = ",".join(["%s: %s" % (x[0], x[1]) for x in ann.items()])
        print("\tdef %s(%s) -> %s" % (name, val, ret))
    