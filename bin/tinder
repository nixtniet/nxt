#!/usr/bin/env python3
# This file is placed in the Public Domain.
# pylint: disable=C0413


"stress test"


import os
import shutil
import sys
import threading
import time


sys.path.insert(0, os.getcwd())


from nixt.defines import Booting, Commands, Main, Message, Method, Parser
from nixt.defines import Mods, Pool, Screen, Task, Time, Workdir


Workdir.wdr = ".test"


class CLI(Screen):

    "Command Line Interface"

    def __init__(self):
        Screen.__init__(self)
        self.register("command", Commands.command)

    def raw(self, text):
        "write to console."
        if Main.verbose:
            print(text.encode('utf-8', 'replace').decode("utf-8"))
            sys.stdout.flush()


class Kernel(Booting):

    "teh kernal"

    messages = []
    nrevents = 0
    starttime = time.time()

    @classmethod
    def boot(cls):
        cls.configure()
        Mods.dir("mods", "mods")
        Commands.scanner()
        if os.path.exists(Workdir.wdr):
            shutil.rmtree(Workdir.wdr)
        if Main.threaded:
            Pool.nrcpu = os.cpu_count()
        else:
            Pool.nrcpu = 1
        Pool.init(Pool.nrcpu, CLI)

    @classmethod
    def launch(cls):
        "launch commands."
        nrs = Main.index or 1
        thrs = []
        for _x in range(nrs):
            thrs.append(Task.start(cls.payload, pre))
        for thr in thrs:
            thr.join()
        thrs = []
        for _x in range(nrs):
            thrs.append(Task.start(cls.payload, examples))
        for thr in thrs:
            thr.join()
        thrs = []
        for _x in range(nrs):
            thrs.append(Task.start(cls.payload, post))
        for thr in thrs:
            thr.join()

    @classmethod
    def payload(cls, todo):
        "payload to run."
        for cmd, example in todo.items():
            for ex in example:
                Kernel.nrevents += 1
                evt = Message()
                evt.kind = "command"
                evt.text = f"{cmd} {ex}"
                Pool.put(evt)
                cls.messages.append(evt)


    @classmethod
    def final(cls):
        "finalizer."
        if not Main.verbose:
            return
        total = Kernel.nrevents
        endtime = time.time()
        lap = Time.elapsed(endtime-Kernel.starttime)
        percall = (endtime-Kernel.starttime)/total
        print(f"{Method.fmt(Main, skip='otxt,txt')}")
        print(f"nrcpu: {Pool.nrcpu} events: {total}")
        print(f"total: {lap} nrs: {Kernel.nrevents} call: {percall}")
        print(threading.enumerate())


def main():
    "main code."
    Parser.parse(Main, " ".join(sys.argv[1:]))
    Kernel.boot()
    Kernel.launch()
    Kernel.shutdown()


examples = {
    "cmd": [""],
