#!/usr/bin/env python3
# This file is placed in the Public Domain.


"stress test"


import logging
import os
import sys
import threading
import time
import _thread


sys.path.insert(0, os.getcwd())


from nxt.defines import Client, Clients, Commands, Main, Message, Pool
from nxt.defines import MD5, Method, Mods, Parser, Task, Time


class Kernel:

    nrevents = 0
    starttime = 0

    @classmethod
    def banner(cls, force=False):
        "hello."
        if not force and not Main.verbose:
            return
        tmr = time.ctime(time.time()).replace("  ", " ")
        txt = "%s since %s %s (%s)" % (
            Main.name.upper(),
            tmr,
            Main.level.upper() or "WARNING",
            MD5.core()
        )
        print(txt.replace("  ", " "))
        sys.stdout.flush()

    @classmethod
    def boot(cls):
        Parser.parse(Main, " ".join(sys.argv[1:]))
        if "v" in Main.opts:
            Main.verbose = True
        print(Main)
        Mods.dir(Mods.moddir())
        Mods.dir("mods", "mods")
        if Main.verbose:
            print("yo!")
            cls.banner()
            Commands.scanner()

    @classmethod
    def shutdown(cls):
        "call stop on clients."
        Clients.shutdown()
        while True:
            if len(threading.enumerate()) == 1:
                break
            time.sleep(0.1)

    @classmethod
    def wrap(cls, func, *args, dofinal=None):
        "restore console."
        import termios
        try:
            old = termios.tcgetattr(sys.stdin.fileno())
        except termios.error:
            old = False
        cls.wrapped(func, *args)
        if old:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        if dofinal:
            dofinal()

    @classmethod
    def wrapped(cls, func, *args):
        "wrap function in a try/except, silence ctrl-c/ctrl-d."
        try:
            func(*args)
        except (KeyboardInterrupt, EOFError):
            Client.block.set()
            Task.block.set()
            _thread.interrupt_main()
        except Exception as ex:
            logging.exception(ex)
            _thread.interrupt_main()


class CLI(Client):

    def __init__(self):
        Client.__init__(self)
        self.register("command", Commands.command)

    def raw(self, text):
        "write to console."
        if "v" in Main.opts:
            print(text.encode('utf-8', 'replace').decode("utf-8"))
            sys.stdout.flush()


pool = Pool(Client)


def payload(todo):
    for cmd, example in todo.items():
        for ex in example:
            Kernel.nrevents += 1
            evt = Message()
            evt.kind = "command"
            evt.text = f"{cmd} {ex}"
            pool.put(evt)


def final():
    if "v" not in Main.opts:
        return
    total = Kernel.nrevents
    endtime = time.time()
    lap = Time.elapsed(endtime-Kernel.starttime)
    percall = (endtime-Kernel.starttime)/total
    print(f"{Method.fmt(Main, skip='otxt,txt')}")
    print(f"events: {total}")
    print(f"total: {lap} nrs: {Kernel.nrevents} call: %.6fs" % percall)
    print(threading.enumerate())


def main():
    Kernel.boot()
    if "t" in Main.opts:
        nrcpu = os.cpu_count()
    else:
        nrcpu = 1
    Kernel.starttime = time.time()
    pool.init(nrcpu)
    nrs = Main.index or 1
    for _x in range(nrs):
        payload(pre)
    for _x in range(nrs):
        payload(examples)
    for _x in range(nrs):
        payload(post)
    Kernel.shutdown()


examples = {
    "cmd": [""],
    "dis": [""],
    "dpl": ["", "tittle.link"],
    "eml": ["", "root@localhost"],
    "flt": ["", "0"],
    "fnd": ["", "log", "todo"],
    "fie": ["", "log", "todo"],
    "lou": [""],
    "mbx": ["", "~/25-1-2013"],
    "man": ["", "nixbot nixtniet@gmail.com Nixt Niet"],
    "nme": ["", "hnrss hn"],
    "now": [""],
    "pth": [""],
    "pwd": ["", "bla mekker"],
    "req": [""],
    "res": ["", "hnrss"],
    "sil": [""],
    "slg": [""],
    "srv": [""],
    "tbl": [""],
    'thr': [""],
    'upt': [""],
    'ver': [""],
}


pre = {
    "cfg": [
        '',
        'main',
        'irc',
        'rss',
        'rst',
        'udp',
        'web',
        'main nick=mekker',
        'irc nick=mekker',
        'rss nick=mekker',
        'rst nick=mekker',
        'udp nick=mekker',
        'web nick=mekker'
    ],
    "imp": [
        "",
        "testing/opml/feeds.opml",
    ],
    "log": ["", "test"],
    "rss": ["", "http://hnrss.org/newest", "https://www.icc-cpi.int/rss/records/all"],
    "tdo": ["", "test2"],
    "tmr": ["", "22:00 test"]
}


post = {
    "dbg": [""],
    "dne": ["", "mekker"],
    "exp": [""],
    "rem": ["", "rem hnrss"]
}


if __name__ == "__main__":
    Kernel.wrap(main, dofinal=final)
