#!/usr/bin/env python3
# This file is placed in the Public Domain.


"stress test"


import logging
import os
import shutil
import sys
import threading
import time
import _thread


sys.path.insert(0, os.getcwd())


from nxt.defines import Client, Commands, Main, Message
from nxt.defines import Method, Mods, Parser, Time


class Kernel:

    nrevents = 0
    starttime = 0

    @classmethod
    def boot(cls):
        Parser.parse(Main, " ".join(sys.argv[1:]))
        Mods.dir("mods", "mods")
        Mods.dir(Mods.moddir())
        Commands.scanner()
        
    @classmethod
    def wrap(cls, func, *args, dofinal=None):
        "restore console."
        import termios
        try:
            old = termios.tcgetattr(sys.stdin.fileno())
        except termios.error:
            old = False
        cls.wrapped(func, *args)
        if old:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        if dofinal:
            dofinal()

    @classmethod
    def wrapped(cls, func, *args):
        "wrap function in a try/except, silence ctrl-c/ctrl-d."
        try:
            func(*args)
        except (KeyboardInterrupt, EOFError):
            Client.block.set()
            Task.block.set()
            _thread.interrupt_main()
        except Exception as ex:
            logging.exception(ex)
            _thread.interrupt_main()


class CLI(Client):

    def __init__(self):
        Client.__init__(self)
        self.register("command", Commands.command)

    def raw(self, text):
        "write to console."
        if "v" in Main.opts:
            print(text.encode('utf-8', 'replace').decode("utf-8"))
            sys.stdout.flush()


class Runners:

    runners = []
    lock = threading.RLock()
    nrcpu = 1
    nrlast = 0

    @staticmethod
    def add(client):
        "add a runner."
        Runners.runners.append(client)

    @staticmethod
    def init(nrcpu, cls):
        "initialize a runner."
        Runners.nrcpu = nrcpu
        for _x in range(Runners.nrcpu):
            clt = cls()
            clt.start()
            Runners.add(clt)

    @staticmethod
    def put(*args):
        "push job to a runner."
        if not Runners.runners:
            Runners.init(Runners.nrcpu, CLI)
        with Runners.lock:
            if Runners.nrlast >= Runners.nrcpu-1:
                Runners.nrlast = 0
            clt = Runners.runners[Runners.nrlast]
            clt.put(*args)
            Runners.nrlast += 1


def payload(todo):
    for cmd, example in todo.items():
        for ex in example:
            Kernel.nrevents += 1
            evt = Message()
            evt.kind = "command"
            evt.text = f"{cmd} {ex}"
            Runners.put(evt)


def final():
    if "v" not in Main.opts:
        return
    total = Kernel.nrevents
    endtime = time.time()
    lap = Time.elapsed(endtime-Kernel.starttime)
    percall = (endtime-Kernel.starttime)/total
    print(f"{Method.fmt(Main, skip='otxt,txt')}")
    print(f"events: {total}")
    print(f"total: {lap} nrs: {Kernel.nrevents} call: %.6fs" % percall)
    print(threading.enumerate())


def main():
    Kernel.boot()
    if "t" in Main.opts:
        nrcpu = os.cpu_count()
    else:
        nrcpu = 1
    Runners.init(nrcpu, CLI)
    Kernel.starttime = time.time()
    nrs = Main.index or 1
    for _x in range(nrs):
        payload(pre)
    for _x in range(nrs):
        payload(examples)
    for _x in range(nrs):
        payload(post)


examples = {
    "cmd": [""],
    "dis": [""],
    "dpl": ["", "tittle.link"],
    "eml": ["", "root@localhost"],
    "flt": ["", "0"],
    "fnd": ["", "log", "todo"],
    "fie": ["", "log", "todo"],
    "lou": [""],
    "mbx": ["", "~/25-1-2013"],
    "man": ["", "nixbot nixtniet@gmail.com Nixt Niet"],
    "nme": ["", "hnrss hn"],
    "now": [""],
    "pth": [""],
    "pwd": ["", "bla mekker"],
    "req": [""],
    "res": ["", "hnrss"],
    "sil": [""],
    "slg": [""],
    "srv": [""],
    "tbl": [""],
    'thr': [""],
    'upt': [""],
    'ver': [""],
}


pre = {
    "cfg": [
        '',
        'main',
        'irc',
        'rss',
        'rst',
        'udp',
        'web',
        'main nick=mekker',
        'irc nick=mekker',
        'rss nick=mekker',
        'rst nick=mekker',
        'udp nick=mekker',
        'web nick=mekker'
    ],
    "imp": [
        "",
        "testing/opml/feeds.opml",
    ],
    "log": ["", "test"],
    "rss": ["", "http://hnrss.org/newest", "https://www.icc-cpi.int/rss/records/all"],
    "tdo": ["", "test2"],
    "tmr": ["", "22:00 test"]
}


post = {
    "dbg": [""],
    "dne": ["", "mekker"],
    "exp": [""],
    "rem": ["", "rem hnrss"]
}


if __name__ == "__main__":
    Kernel.wrap(main, dofinal=final)
