#!/usr/bin/env python3
# This file is placed in the Public DOmain.


"run linters"


import os
import sys


NAME = "nixt"


SKIP = ["---", "Your", "All", "Success"]


def doskip(line):
    for x in SKIP:
        if x in line:
            return True
    return False     


def popen(txt):
    for line in os.popen(txt).readlines():
        line = line.strip()
        if not line or doskip(line):
            continue
        print(line.rstrip())
        sys.stdout.flush()


popen(f"ruff check {NAME} bin/tinder mods extra testing")
popen(f"pylint {NAME} bin/tinder mods extra testing")
popen(f"mypy -p {NAME} -p mods -p extra -p testing")
popen("ty check nixt")
popen("bin/tinder")
